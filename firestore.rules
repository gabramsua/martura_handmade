rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'gabramsua@gmail.com'
      ];
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /productCategories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /productSubcategories/{subcategoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /productCollections/{collectionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /discountCodes/{discountCodeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /shopSettings/{settingsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /contactMessages/{messageId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
